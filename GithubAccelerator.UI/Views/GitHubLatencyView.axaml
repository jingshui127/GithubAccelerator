<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GithubAccelerator.UI.ViewModels"
             xmlns:ctrl="using:GithubAccelerator.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="GithubAccelerator.UI.Views.GitHubLatencyView"
             x:DataType="vm:GitHubLatencyViewModel">

    <Border Padding="16"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="12" BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- 标题和状态 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🌐" FontSize="20"/>
                    <StackPanel>
                        <TextBlock Text="GitHub 单次请求响应（不含页面加载）" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,16,0">
                    <Border Background="#4CAF50" CornerRadius="4" Padding="8,4"
                            IsVisible="{Binding LatencyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding LatencyStatus}" FontSize="11" FontWeight="Medium" 
                                   Foreground="White"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Content="▶ 开始测速" Command="{Binding StartMonitoringCommand}"
                        Padding="10,4" FontSize="12" Margin="0,0,8,0"
                        IsVisible="{Binding !IsMonitoring}"
                        ToolTip.Tip="每 10 秒做一次单次请求采样，不改系统设置"/>
                <Button Grid.Column="2" Content="⏸ 暂停测速" Command="{Binding StopMonitoringCommand}"
                        Padding="10,4" FontSize="12" Margin="0,0,8,0"
                        IsVisible="{Binding IsMonitoring}"
                        ToolTip.Tip="只暂停采样，不改 Hosts"/>
                
                <Button Grid.Column="3" Content="清除数据" Command="{Binding ClearDataCommand}"
                        Padding="10,4" FontSize="12"
                        ToolTip.Tip="只清空本页的采样记录"/>
            </Grid>

            <!-- 图表区域 - 使用自绘图表 -->
            <Border Grid.Row="1" Padding="8" Margin="0,0,0,12"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                <Border IsVisible="{Binding !HasSamples}" Padding="24" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock Text="还没有采样数据：点右上角「▶ 开始测速」，每 10 秒记录一次单次请求响应。"
                               FontSize="12" TextWrapping="Wrap" Classes="SecondaryText"
                               HorizontalAlignment="Center"/>
                </Border>
                <ctrl:SimpleLineChart Values="{Binding ChartValues}"
                                      IsVisible="{Binding HasSamples}"
                                      YAxisLabel="响应时间 (ms)"
                                      XAxisLabel="测试次数"
                                      MinY="0"
                                      MaxY="{Binding ChartMaxY}"
                                      LineColor="#4FC3F7"
                                      FillColor="#1A4FC3F7"
                                      AxisColor="#666666"
                                      TextColor="#999999"/>
                <TextBlock Margin="4,8,4,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="度量口径：每 10 秒对 github.com 的单次请求首字节/响应（favicon → 首页 → API，取首个成功），只代表单个请求，不代表整页打开耗时。整页对比请在「检查与修复 → 官网诊断」查看备选 IP 与当前直连的整页打开实测。"/>
                </StackPanel>
            </Border>

            <!-- 底部统计 -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Padding="12,8" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="当前（单次请求）" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentLatencyText}" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="12,8" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="平均（单次请求）" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AverageLatencyText}" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="12,8" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="最快（单次请求）" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MinLatencyText}" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Padding="12,8" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="最慢（单次请求）" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MaxLatencyText}" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
