<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GithubAccelerator.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="GithubAccelerator.UI.Views.LogViewerView"
             x:DataType="vm:LogViewerViewModel">

    <Design.DataContext>
        <vm:LogViewerViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="24">
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="日志查看器" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>

            <TextBox Grid.Column="1"
                     Text="{Binding SearchText}"
                     Watermark="搜索关键词（时间/级别/消息）..."
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding LogLevels}" SelectedValue="{Binding SelectedLogLevel}" Width="120"/>
            </StackPanel>

            <Button Grid.Column="3" Content="导出日志" Command="{Binding ExportLogsCommand}"
                    Theme="{DynamicResource SolidButton}"
                    Padding="12,4" Margin="8,0,0,0"
                    ToolTip.Tip="导出当前筛选后的日志到 txt 文件"/>

            <Button Grid.Column="4" Content="清空日志" Command="{Binding ClearLogsCommand}"
                    Theme="{DynamicResource SecondaryButton}"
                    Padding="12,4" Margin="8,0,0,0"/>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Panel>
                <ListBox x:Name="LogsListBox"
                         ItemsSource="{Binding FilteredLogs}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryViewModel">
                            <Border Padding="8" Margin="0,0,0,1" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding FormattedTime}"
                                               FontSize="11" Foreground="Gray" Margin="0,0,8,0"
                                               FontFamily="Consolas, Courier New, monospace"/>
                                    <Border Grid.Column="1" Padding="4,2" CornerRadius="4"
                                            Margin="0,0,8,0"
                                            Background="{Binding LevelBackground}">
                                        <TextBlock Text="{Binding Level}" FontSize="10"
                                                   Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                    <Button Grid.Column="3" Content="复制" Command="{Binding CopyMessageCommand}"
                                            Padding="4,2" FontSize="10"
                                            IsVisible="{Binding HasException}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel IsVisible="{Binding HasNoLogs}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无日志" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="执行检查、修复或恢复操作后，这里会出现记录；也可用上方类型和级别筛选。"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"/>
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
