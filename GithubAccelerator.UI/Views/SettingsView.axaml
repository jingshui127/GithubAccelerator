<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GithubAccelerator.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GithubAccelerator.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.DataContext>
    </UserControl.DataContext>

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Padding="24" Background="{DynamicResource BackgroundColor}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="600">

                <!-- 监控设置 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="监控设置" FontSize="16" FontWeight="SemiBold"/>

                    <Border Padding="16" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel>
                                <TextBlock Text="测试间隔（秒）" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="每隔多少秒测试一次所有数据源（建议 600 秒/10 分钟）" FontSize="12" Classes="SecondaryText"/>
                                <NumericUpDown Value="{Binding TestInterval}"
                                               Minimum="30" Maximum="3600"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Left" Width="200"/>
                                <TextBlock Text="{Binding TestIntervalError}"
                                           FontSize="12" Foreground="Red"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 启动设置 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="启动设置" FontSize="16" FontWeight="SemiBold"/>

                    <Border Padding="16" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding AutoStart}" HorizontalAlignment="Left"/>
                                <StackPanel>
                                    <TextBlock Text="开机自启动" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="系统启动时自动运行" FontSize="12" Classes="SecondaryText"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Hosts 设置 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Hosts 设置" FontSize="16" FontWeight="SemiBold"/>

                    <Border Padding="16" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding AutoApplyHosts}" HorizontalAlignment="Left"/>
                                <StackPanel>
                                    <TextBlock Text="自动应用 Hosts" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="启动时自动应用最佳数据源的 Hosts" FontSize="12" Classes="SecondaryText"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding AutoSwitchBestSource}" HorizontalAlignment="Left"/>
                                <StackPanel>
                                    <TextBlock Text="自动切换最快线路" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="当发现更快的线路时自动切换（单次请求比当前快 20 ms 以上）" FontSize="12" Classes="SecondaryText"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding AutoFlushDns}" HorizontalAlignment="Left"/>
                                <StackPanel>
                                    <TextBlock Text="自动刷新DNS缓存" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="应用Hosts后自动刷新系统DNS缓存，使配置立即生效" FontSize="12" Classes="SecondaryText"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Git 加速 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Git 加速" FontSize="16" FontWeight="SemiBold"/>

                    <Border Padding="16" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel>
                                <TextBlock Text="Git 加速（改写 clone 地址）" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding GitRewriteStatus}" FontSize="12" Classes="SecondaryText"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding GitRewriteAdvice}" FontSize="12"
                                           Foreground="#E8A23D" TextWrapping="Wrap"
                                           IsVisible="{Binding HasGitRewriteAdvice}"/>
                                <TextBlock Text="{Binding GitRewriteProgressText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryColor}"
                                           IsVisible="{Binding GitRewriteProgressText, Converter={StaticResource StringNotEmptyConverter}}"
                                           ToolTip.Tip="确定进度：只报已完成项数，不猜百分比"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Git 加速地址" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="用 url.&lt;镜像&gt;.insteadOf 改写 https://github.com/ 开头的地址，只影响 clone/fetch/pull；push 需要鉴权，仍直连 GitHub"
                                           FontSize="12" Classes="SecondaryText" TextWrapping="Wrap"/>
                                <TextBlock Text="加速只作用于下载与克隆（clone/fetch/raw/release）；push 仍直连 github.com，不走镜像。若 push 失败，请重试或更换网络，加速器无法改善 push。"
                                           Margin="0,4,0,0"
                                           FontSize="12" Classes="SecondaryText" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding GitMirrorBaseUrl}"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="开启 Git 加速" Command="{Binding EnableGitRewriteCommand}"
                                        Padding="16,6" FontSize="13"/>
                                <Button Content="恢复原始 Git 地址" Command="{Binding DisableGitRewriteCommand}"
                                        Padding="16,6" FontSize="13"
                                        ToolTip.Tip="只撤销本程序的 Git 地址改写，不动 Hosts"/>
                                <Button Content="使用推荐加速地址" Command="{Binding UseRecommendedGitRewriteCommand}"
                                        Padding="16,6" FontSize="13"/>
                            </StackPanel>

                            <Border Padding="12" CornerRadius="6"
                                    Background="#FFF8E1" BorderBrush="#FFB74D" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="加速范围（部分路径，不是全站）" FontSize="12" FontWeight="SemiBold" Foreground="#8D6E00"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#6D5A00"
                                               Text="覆盖：git clone/fetch/pull、raw.githubusercontent.com 文件、release 下载、公开仓库页面。不需要加速：api.github.com 接口与需要登录的操作（直连可用）；直连是否可用视当时网络而定，直连可用时优先直连。页面内脚本请求与 ghcr.io 容器镜像不在覆盖范围。镜像站不可用时工具会提示原因，不会假装已加速。"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="12" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="清理历史 Git Proxy 污染" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding LegacyProxyStatus}" FontSize="12" Classes="SecondaryText"
                                               TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding LegacyProxyEntryLines}"
                                                  IsVisible="{Binding HasLegacyProxyEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="清理以上条目" Command="{Binding CleanupLegacyGitProxyCommand}"
                                            IsVisible="{Binding HasLegacyProxyEntries}"
                                            Padding="16,6" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 托盘设置 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="托盘设置" FontSize="16" FontWeight="SemiBold"/>

                    <Border Padding="16" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding MinimizeToTray}" HorizontalAlignment="Left"/>
                                <StackPanel>
                                    <TextBlock Text="最小化到托盘" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="最小化窗口时隐藏到系统托盘（切换后立即生效）" FontSize="12" Classes="SecondaryText"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding ShowTrayNotifications}" HorizontalAlignment="Left"/>
                                <StackPanel>
                                    <TextBlock Text="显示托盘通知" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Hosts 自动刷新或状态变化时显示托盘气泡提示" FontSize="12" Classes="SecondaryText"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 隐私与诊断 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="隐私与诊断" FontSize="16" FontWeight="SemiBold"/>

                    <Border Padding="16" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ToggleSwitch IsChecked="{Binding DiagnosticsEnabled}" HorizontalAlignment="Left"/>
                                <StackPanel>
                                    <TextBlock Text="诊断信息上报" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="默认关闭。开启后会采集应用版本、CPU/内存/线程数与关键操作结果，发送到开发者自建的监控服务器（47.113.219.65:6600），用于发现崩溃和性能问题。关闭时不会发出任何上报请求，可随时在此关闭。"
                                               FontSize="12" Classes="SecondaryText" TextWrapping="Wrap" MaxWidth="520"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 故障排查：只生成本地诊断包，绝不自动上传 -->
                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="故障排查 · 诊断包" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="收集日志、脱敏后的设置、本程序涉及的 Git 键、镜像健康结果、系统信息和自己的 Hosts 块。导出前先列出清单与被脱敏的字段；只保存到本地，不会自动上传或发送。"
                                               FontSize="12" Classes="SecondaryText" TextWrapping="Wrap" MaxWidth="520"/>
                                    <Button Content="生成诊断包（先预览）"
                                            Command="{Binding OpenDiagnosticsBundleCommand}"
                                            Padding="16,6" FontSize="13" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 日志设置 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="日志设置" FontSize="16" FontWeight="SemiBold"/>

                    <Border Padding="16" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="日志级别" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="设置日志记录的详细程度" FontSize="12" Classes="SecondaryText"/>
                            <ComboBox SelectedItem="{Binding LogLevel}"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Left" Width="200">
                                <x:String>Debug</x:String>
                                <x:String>Information</x:String>
                                <x:String>Warning</x:String>
                                <x:String>Error</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 关于与反馈已统一到「帮助与支持」页 -->

            </StackPanel>
        </ScrollViewer>

        <!-- 保存按钮 -->
        <Border Grid.Row="1" Padding="16" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button Content="📦 导出数据" Command="{Binding ExportAllDataCommand}"
                        Padding="16,10" FontSize="14"
                        ToolTip.Tip="导出设置、分组、加速线路与历史，用于换机器或重装迁移"/>
                <Button Content="📥 导入数据" Command="{Binding ImportAllDataCommand}"
                        Padding="16,10" FontSize="14"
                        ToolTip.Tip="从导出的数据包恢复设置、分组与加速线路"/>
                <Button Content="🔄 恢复默认" Command="{Binding ResetToDefaultsCommand}"
                        Padding="16,10" FontSize="14"/>
                <Button Content="💾 保存设置" Command="{Binding SaveSettingsCommand}"
                        Padding="24,10" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
