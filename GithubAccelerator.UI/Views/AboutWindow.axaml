<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="GithubAccelerator.UI.Views.AboutWindow"
        Title="关于 GitHub 加速器 Pro"
        Width="450" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False">

    <StackPanel Margin="24" Spacing="16" HorizontalAlignment="Center">
        <!-- Logo -->
        <Image Source="/Assets/logo.png" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,8,0,0 "/>
        
        <!-- Title -->
        <TextBlock Text="GitHub 加速器 Pro" FontSize="20" FontWeight="SemiBold" 
                   HorizontalAlignment="Center"/>
        
        <TextBlock Text="智能 Hosts 管理与加速工具" FontSize="12" Classes="SecondaryText" 
                   HorizontalAlignment="Center"/>

        <!-- Version -->
        <Border Padding="16,8" CornerRadius="8" 
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="版本：" FontSize="13"/>
                    <TextBlock Grid.Column="1" x:Name="VersionText" FontSize="13" FontWeight="SemiBold"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="构建日期：" FontSize="13"/>
                    <TextBlock Grid.Column="1" x:Name="BuildDateText" FontSize="13"/>
                </Grid>
                <StackPanel Spacing="6" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click"
                                Padding="12,4" FontSize="12"/>
                        <Button x:Name="OpenReleasesButton" Content="打开发布页" Click="OpenReleases_Click"
                                Padding="12,4" FontSize="12" IsVisible="False"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText"
                               Text="仅在你点击时检查一次；不会随启动自动联网。"
                               FontSize="11" Classes="SecondaryText" TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Company Info -->
        <Border Padding="16,8" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="开发：" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="科控物联科技有限公司" FontSize="13" FontWeight="SemiBold"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="QQ：" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="2492123056" FontSize="13"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="微信公众号：" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="科控物联" FontSize="13"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Description -->
        <TextBlock Text="GitHub 加速器 Pro 是一款专为国内用户设计的 GitHub 访问加速工具。&#10;通过比较备选 IP 与当前直连的整页打开耗时，只在至少快 20% 且你确认后更新 Hosts 文件，&#10;帮助你更稳定地访问 GitHub 资源。" 
                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>

        <!-- Copyright -->
        <TextBlock Text="© 2026 科控物联科技有限公司. All rights reserved." 
                   FontSize="11" Classes="SecondaryText"
                   HorizontalAlignment="Center"/>

        <!-- Close Button -->
        <Button Content="关闭" Click="CloseButton_Click" 
                Theme="{DynamicResource PrimaryButton}"
                Padding="24,6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
