<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GithubAccelerator.UI.ViewModels"
             xmlns:controls="using:GithubAccelerator.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="GithubAccelerator.UI.Views.DashboardView"
             x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <!-- 骨架屏加载状态 -->
        <Border IsVisible="{Binding IsLoading}" Padding="24">
            <StackPanel Spacing="20">
                <!-- ① 能不能用 骨架 -->
                <Border Height="130" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}"/>

                <!-- ② 快不快 / 哪里慢 骨架（三卡） -->
                <Grid ColumnDefinitions="*,*,*">
                    <Border Grid.Column="0" Height="130" Margin="0,0,8,0" CornerRadius="12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                    <Border Grid.Column="1" Height="130" Margin="4,0,4,0" CornerRadius="12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                    <Border Grid.Column="2" Height="130" Margin="8,0,0,0" CornerRadius="12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                </Grid>
                
                <!-- 推荐数据源骨架 -->
                <Border Height="100" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                
                <!-- 数据源列表骨架 -->
                <StackPanel Spacing="8">
                    <Border Height="20" Width="150" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            HorizontalAlignment="Left"/>
                    <Border Height="70" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                    <Border Height="70" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                    <Border Height="70" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 实际内容 -->
        <ScrollViewer Padding="24" Background="{DynamicResource BackgroundColor}" HorizontalAlignment="Stretch"
                      IsVisible="{Binding !IsLoading}">
            <StackPanel Spacing="20" Margin="0,0,0,80" HorizontalAlignment="Stretch">
                
                <!-- ① 能不能用：一句结论 + 一个动作 -->
                <Border Padding="20" CornerRadius="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="现在能不能用 GitHub？" FontSize="11" Classes="SecondaryText"/>

                        <TextBlock Text="{Binding AvailabilityConclusion}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding AvailabilityDetail}" FontSize="12" Classes="SecondaryText" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding AccelerationProgressText}" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MinHeight="30"
                                   IsVisible="{Binding IsApplyingHosts}"
                                   ToolTip.Tip="确定进度：只报已完成的组数与项数，不猜百分比；等待秒数每秒刷新"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="🚀 开启网页加速" Command="{Binding ApplyHostsCommand}"
                                    IsVisible="{Binding !IsHostsApplied}"
                                    IsEnabled="{Binding !IsApplyingHosts}"
                                    Padding="16,8" FontSize="13" FontWeight="SemiBold"
                                    ToolTip.Tip="先测速比较：比直连至少快 20% 才写入；否则不改任何系统文件、不弹管理员确认。写入后可随时恢复原始访问"/>
                            <Button Content="↩️ 恢复原始访问" Command="{Binding ClearAppliedHostsCommand}"
                                    IsVisible="{Binding IsHostsApplied}"
                                    Padding="16,8" FontSize="13" FontWeight="SemiBold"
                                    ToolTip.Tip="移除本程序的 Hosts 加速块，GitHub 回到原始直连"/>
                            <Button Content="中止本次加速" Command="{Binding CancelApplyCommand}"
                                    IsVisible="{Binding CanCancelApply}"
                                    Padding="10,6" FontSize="12" ToolTip.Tip="只中止进行中的任务，不会写入 Hosts"/>
                            <Button Content="🩺 检查与修复 ›" Command="{Binding ShowCheckAndRepairCommand}"
                                    Padding="12,8" FontSize="12"
                                    ToolTip.Tip="依赖站点检查、官网诊断、单次响应统计统一入口"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ② 快不快 / 哪里慢：只保留整页、单次、下载三种口径 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="快不快 / 哪里慢" FontSize="11" Classes="SecondaryText"/>

                    <Grid ColumnDefinitions="*,*,*">
                        <!-- 整页（主指标） -->
                        <Border Grid.Column="0" Padding="16,12" Margin="0,0,8,0" CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock Text="整页打开耗时（页面基本加载完）" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OfficialSiteDiagnostics.Guard.PreviewPairingText}"
                                           IsVisible="{Binding OfficialSiteDiagnostics.Guard.HasPairingText}"
                                           FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="尚未实测 — 点下方「去实测」" FontSize="12" Classes="SecondaryText"
                                           IsVisible="{Binding !OfficialSiteDiagnostics.Guard.HasPairingText}"/>
                                <TextBlock Text="秒 · 页面基本加载完（不执行页面脚本）· 手动实测；只作相对比较，不是绝对真值。"
                                           FontSize="10" Classes="SecondaryText" TextWrapping="Wrap"/>
                                <Button Content="去实测 ›" Command="{Binding ShowCheckAndRepairCommand}"
                                        Padding="10,4" FontSize="11" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- 单次请求 -->
                        <Border Grid.Column="1" Padding="16,12" Margin="4,0,4,0" CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock Text="单次请求响应" FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding BestSourceResponseText}" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CurrentBestSourceText}" FontSize="11" Classes="SecondaryText"
                                               VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock Text="ms · 一次请求到首字节 · 最快线路测 3 次取中间值 · 每 10 秒"
                                           FontSize="10" Classes="SecondaryText" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding HasLatencyComparison}">
                                    <TextBlock Text="{Binding PreApplyLatency}" FontSize="11" Classes="SecondaryText" VerticalAlignment="Center"/>
                                    <TextBlock Text="→" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PostApplyLatency}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding ImprovementColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LatencyImprovement}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding ImprovementColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="加速前 → 加速后对比；测速期间会临时移除加速。"
                                           IsVisible="{Binding HasLatencyComparison}"
                                           FontSize="10" Classes="SecondaryText" TextWrapping="Wrap"/>
                                <Button Content="🔄 重新测速" Command="{Binding RunSpeedTestCommand}"
                                        Padding="10,4" FontSize="11" HorizontalAlignment="Left"
                                        ToolTip.Tip="会临时移除加速再测，测速期间打开的网页不是加速后结果"/>
                            </StackPanel>
                        </Border>

                        <!-- 下载 -->
                        <Border Grid.Column="2" Padding="16,12" Margin="8,0,0,0" CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock Text="下载速度" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="未测（限速时再测，不做假数字）" FontSize="12" Classes="SecondaryText"/>
                                <TextBlock Text="MB/s · 仅镜像下载链接速度，不代表网页"
                                           FontSize="10" Classes="SecondaryText" TextWrapping="Wrap"/>
                                <Button Content="去下载加速器测速 ›" Command="{Binding ShowDownloadAcceleratorCommand}"
                                        Padding="10,4" FontSize="11" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ③ 出问题怎么办：只在失败时出现，一句人话原因 + 一个主动作 + 原始链接 -->
                <Border Padding="16,12" CornerRadius="12"
                        IsVisible="{Binding HasAllSourcesFailure}"
                        Background="#1AF44336"
                        BorderBrush="#F44336" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="出问题怎么办 · 所有加速线路都不可用" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#F44336"/>
                            <TextBlock Text="只说明这些线路探测失败，不代表 github.com 直连打不开。"
                                       FontSize="11" Classes="SecondaryText" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding AllSourcesFailureText}" FontSize="11"
                                       TextWrapping="Wrap" Classes="SecondaryText"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="恢复原始访问（关闭加速）"
                                    Command="{Binding UseDirectConnectionCommand}"
                                    Padding="12,6" FontSize="12"
                                    ToolTip.Tip="移除本程序的 Hosts 加速块，让 GitHub 回到原始链接直连"/>
                            <Button Content="打开 github.com 原始链接 ↗"
                                    Command="{Binding OpenGitHubOriginalCommand}"
                                    Padding="12,6" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="重新开启加速" Command="{Binding ApplyHostsCommand}"
                                        Padding="10,4" FontSize="11"
                                        ToolTip.Tip="先做只读判定（备选 IP 未快 20% 不写、不弹 UAC）；达标后才请求管理员权限写入 Hosts"/>
                                <Button Content="✕ 关闭" Command="{Binding DismissAllSourcesFailureCommand}"
                                        Padding="10,4" FontSize="11"
                                        Background="Transparent" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 加速方式（详情）：一个总概念下的三种机制，默认折叠，不抢主操作 -->
                <Expander Header="加速方式（详情）：网页 / Git / 下载" IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Border Padding="16,12" CornerRadius="12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="🌐" FontSize="18" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="网页加速（本页主开关）" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="SecondaryText" TextWrapping="Wrap"
                                               Text="改写本机域名指向表（Hosts），让 GitHub 页面、CSS/图片、raw 文件、release 下载走更快的 IP；push、登录、issue 不走这里。"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding AccelerationStateText}" FontSize="11"
                                           Classes="SecondaryText" MaxWidth="220" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="🔧" FontSize="18" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Git 加速（改写 clone 地址）" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="SecondaryText" TextWrapping="Wrap"
                                               Text="只把 clone/fetch/pull 的地址换成加速地址，不影响网页；push 仍直连 GitHub。"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="去设置 ›" Command="{Binding ShowSettingsCommand}"
                                        Padding="10,6" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="⬇️" FontSize="18" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="下载加速（换第三方镜像链接）" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Classes="SecondaryText" TextWrapping="Wrap"
                                               Text="把下载/文件链接换成第三方镜像地址，不改系统设置；只覆盖部分路径，不是让 GitHub 全站可访问。"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="去下载加速器 ›" Command="{Binding ShowDownloadAcceleratorCommand}"
                                        Padding="10,6" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 我的加速 · 线路详情（默认折叠，避免首屏堆满逐条数据） -->
                <Expander Header="📡 我的加速 · 线路详情（搜索 / 排序 / 逐条应用）"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding SourcesCountText}" FontSize="12" Classes="SecondaryText"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <!-- 搜索框 -->
                            <TextBox Text="{Binding SearchText}" Watermark="🔍 搜索加速线路..."
                                     Width="180" Padding="8,6"/>
                            <!-- 排序下拉框 -->
                            <ComboBox SelectedIndex="{Binding SortOption}" Width="140" Padding="8,6">
                                <ComboBoxItem Content="内部评分最高"/>
                                <ComboBoxItem Content="单次请求最快"/>
                                <ComboBoxItem Content="单次请求最慢"/>
                                <ComboBoxItem Content="内部评分最低"/>
                                <ComboBoxItem Content="名称排序"/>
                            </ComboBox>
                            <Button Content="全选" Command="{Binding SelectAllSourcesCommand}"
                                    Padding="8,4" FontSize="11"/>
                            <Button Content="取消全选" Command="{Binding DeselectAllSourcesCommand}"
                                    Padding="8,4" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedSourcesCount, StringFormat='已选 {0} 条'}"
                                       FontSize="12" Classes="SecondaryText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding FilteredSources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceStatusViewModel">
                                <Border Padding="16" Margin="0,0,0,8" CornerRadius="10"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
                                        <!-- 复选框 -->
                                        <CheckBox Grid.Column="0" 
                                                  IsChecked="{Binding IsSelected}"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"/>
                                        
                                        <!-- 状态指示灯 -->
                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18"
                                                Background="{Binding StatusColor}" Opacity="0.15"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- 源名称 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Url}" FontSize="10" Classes="SecondaryText"
                                                       TextWrapping="Wrap" MaxWidth="350"/>
                                        </StackPanel>

                                        <!-- DNS探测标记 -->
                                        <Border Grid.Column="3" VerticalAlignment="Center" Margin="8,0"
                                                IsVisible="{Binding IsDnsProbe}"
                                                Background="#20FF9800" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="🔍 DNS探测" FontSize="10" Foreground="#FF9800"/>
                                        </Border>

                                        <!-- 响应时间 -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="16,0" MinWidth="70">
                                            <TextBlock Text="单次请求" FontSize="9" Classes="SecondaryText" HorizontalAlignment="Center"
                                                       ToolTip.Tip="该线路最近探测的平均响应，不含页面加载"/>
                                            <TextBlock Text="{Binding ResponseTimeText}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{Binding ResponseTimeColor}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 评分 -->
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="16,0" MinWidth="50">
                                            <TextBlock Text="内部评分" FontSize="9" Classes="SecondaryText" HorizontalAlignment="Center"
                                                       ToolTip.Tip="内部加权分，只用于线路间比较"/>
                                            <TextBlock Text="{Binding ScoreText}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{Binding ScoreColor}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 应用按钮 -->
                                        <Button Grid.Column="6" Content="预览"
                                                Command="{Binding PreviewHostsCommand}"
                                                IsEnabled="{Binding IsHealthy}"
                                                Padding="8,6" FontSize="11"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                ToolTip.Tip="预览将写入 Hosts 的内容（不写文件）"/>
                                        <Button Grid.Column="7" Content="仅用此线路"
                                                Command="{Binding ApplySingleSourceCommand}"
                                                IsEnabled="{Binding IsHealthy}"
                                                ToolTip.Tip="只把这条线路写入 Hosts，不合并其他线路"
                                                Padding="12,6" FontSize="11"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态显示 -->
                    <Grid IsVisible="{Binding !HasFilteredSources}" Margin="0,40,0,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <TextBlock Text="🔍" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="未找到匹配的加速线路" FontSize="18" FontWeight="SemiBold" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="请尝试修改搜索条件或重新探测线路" FontSize="13" 
                                      HorizontalAlignment="Center" Foreground="#666666"/>
                            <Button Content="重新探测线路" Command="{Binding RefreshSourcesCommand}"
                                   Padding="16,8" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   CornerRadius="6"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                </Expander>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
