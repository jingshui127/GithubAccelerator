<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GithubAccelerator.UI.Views.DiagnosticsPreviewWindow"
        x:CompileBindings="False"
        Title="诊断包预览（不会自动上传）"
        Width="620" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="诊断包预览" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="下面列出将要打包的文件和脱敏规则。确认后才保存 zip；程序不会自动上传或发送，发送与否由你决定。"
                       FontSize="12" Classes="SecondaryText" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" Text="正在生成预览…" FontSize="12" Foreground="{DynamicResource WarningStrongTextBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Spacing="12">
                <TextBlock Text="包含的文件" FontSize="14" FontWeight="SemiBold"/>
                <ItemsControl x:Name="FilesList" ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,6" Margin="0,0,0,6" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding RelativePath}" FontSize="12" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Classes="SecondaryText"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SizeBytes}" FontSize="10" Classes="SecondaryText"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="脱敏规则" FontSize="14" FontWeight="SemiBold"/>
                <ItemsControl x:Name="RulesList" ItemsSource="{Binding RedactionNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" Classes="SecondaryText" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="保存 zip…" Click="Save_Click" IsEnabled="False"
                    Padding="18,6" FontSize="13"/>
            <Button Content="关闭" Click="Close_Click" Padding="18,6" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
